<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      TickCount needs no permissions at all: it is a pure viewer over the
      device clock and its own private storage.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TickCount">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TickCount">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The two home-screen widgets. No permission is involved in either: the launcher
          talks to these receivers through AppWidgetManager, and the midnight refresh uses
          AlarmManager.setAndAllowWhileIdle — the inexact variant, which needs no alarm
          permission.

          Each carries its own name, because a picker offering two entries both called
          TickCount would be asking the user to guess.
        -->
        <receiver
            android:name=".ui.widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name_single">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!-- Nothing to configure: it shows whatever is coming next. -->
        <receiver
            android:name=".ui.widget.UpcomingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_widget_info" />
        </receiver>

        <!-- Started by the launcher, so this one does have to be exported. -->
        <activity
            android:name=".ui.widget.CountdownWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.TickCount">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
