<?xml version="1.0" encoding="utf-8"?>
<!--
  The same panel as widget_background.xml, pinned to one palette.

  A drawable of its own because a RemoteViews cannot tint a shape it has already inflated:
  the panel setting sends one of these three resource ids and the launcher swaps the
  background. The colours they name are defined once, in the default configuration, so
  selecting the light panel on a dark device still draws a light panel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/widget_light_background" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_light_outline" />
</shape>
