<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's own panel. A plain shape rather than a Material one: the launcher inflates
  this outside the app's theme, so theme attributes would not resolve.

  A white card with a one-pixel warm outline, which is the same recipe the app's own cards
  use — raised by contrast with the page rather than by a shadow, which a widget cannot have
  anyway.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/widget_background" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>
