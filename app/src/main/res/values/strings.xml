    <!--
      The tall layout spells the countdown out in calendar units instead of one
      total. Years and months carry a trailing space of their own, so the units can
      be concatenated with nothing in between; the result is trimmed afterwards.
    -->
    <plurals name="widget_years">
        <item quantity="one">"%1$d year "</item>
        <item quantity="other">"%1$d years "</item>
    </plurals>
    <plurals name="widget_months">
        <item quantity="one">"%1$d month "</item>
        <item quantity="other">"%1$d months "</item>
    </plurals>
