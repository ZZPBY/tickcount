<?xml version="1.0" encoding="utf-8"?>
<!--
  Rules for Android 12+ (API 31+) cloud backup / device transfer. Same shape as
  backup_rules.xml, including the widget bindings left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="tickcount_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="tickcount_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
